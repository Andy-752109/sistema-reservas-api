# Copia este archivo a .env y ajusta los valores.

# PostgreSQL (docker-compose)
POSTGRES_USER=reservas
POSTGRES_PASSWORD=reservas
POSTGRES_DB=reservas_db
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://reservas:reservas@localhost:5432/reservas_db?schema=public

# API
PORT=3000
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h
# Orígenes del frontend permitidos; separados por comas, sin rutas.
CORS_ORIGINS=http://localhost:5173
# El pipeline debe suministrar su SHA real en Dev/Prod.
COMMIT_SHA=development

# Disponibilidad de espacios (horario del mismo día, zona IANA)
ESPACIOS_HORA_APERTURA=07:00
ESPACIOS_HORA_CIERRE=21:00
ESPACIOS_ZONA_HORARIA=America/Mexico_City

# Seed explícito: configura tus propios valores antes de prisma db seed.
# Correo y contraseña son obligatorios; no hay credenciales predeterminadas.
SEED_ADMIN_CORREO=
SEED_ADMIN_CONTRASENA=
SEED_ADMIN_NOMBRE=Administrador
