# Copia este archivo a .env y ajusta los valores.

# PostgreSQL (docker-compose)
POSTGRES_USER=reservas
POSTGRES_PASSWORD=reservas
POSTGRES_DB=reservas_db
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://reservas:reservas@localhost:5432/reservas_db?schema=public

# API
PORT=3000
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h
